# CrewWatch frontend environment.
# Copy this file to .env and adjust as needed.

# Backend base URL.
# Live (deployed FastAPI Cloud service, use this for the demo and Vercel):
VITE_API_BASE_URL=https://crewwatch-spaceapps.fastapicloud.dev
# Local backend (when running uvicorn on this machine):
# VITE_API_BASE_URL=http://localhost:8000

# Set to "true" to force the built-in simulated feed (demo mode, no backend needed).
# Leave false in production: the app falls back to simulation automatically
# if the live backend cannot be reached.
VITE_DEMO_MODE=false
